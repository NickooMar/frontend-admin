# Backend base URL (backend-diagnostica), without trailing slash.
# The admin API lives under <endpoint>/api/v1/admin and needs no brand.
# VITE_DIAGNOSTICA_API_ENDPOINT=http://localhost:3101

# Environment label shown in the shell footer (localhost | dev | staging | production).
# VITE_DIAGNOSTICA_ENV=localhost

# Set to "true" when serving the dev server behind the HTTPS reverse proxy
# (https://<name>-admin.diagnostica.com.ar): HMR then goes through wss://<host>:443.
# VITE_HMR_PROXY=true

# Injected by the Docker build; leave unset locally.
# VITE_COMMIT_HASH=
# VITE_COMMIT_DATE=
